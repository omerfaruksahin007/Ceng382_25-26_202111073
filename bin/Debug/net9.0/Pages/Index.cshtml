@page
@model RAZOR_PAGE_KOPYASI.Pages.IndexModel
@{
    ViewData["Title"] = "Class List";
}

<h2>Class Information</h2>

<form method="get">
    <table border="1" cellpadding="5" cellspacing="0" id="classTable">
        <thead>
            <tr>
                <th class="selectable-column" data-col="ClassName">
                    Class Name<br />
                    <input type="text" name="ClassNameFilter" value="@Model.ClassNameFilter" />
                </th>
                <th class="selectable-column" data-col="Instructor">
                    Instructor<br />
                    <input type="text" name="InstructorFilter" value="@Model.InstructorFilter" />
                </th>
                <th class="selectable-column" data-col="Capacity">
                    Capacity<br />
                    <input type="text" name="CapacityFilter" value="@Model.CapacityFilter" />
                </th>
                <th class="selectable-column" data-col="Semester">
                    Semester<br />
                    <input type="text" name="SemesterFilter" value="@Model.SemesterFilter" />
                </th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.FilteredData)
            {
                <tr class="selectable-row">
                    <td class="col-ClassName">@item.ClassName</td>
                    <td class="col-Instructor">@item.Instructor</td>
                    <td class="col-Capacity">@item.Capacity</td>
                    <td class="col-Semester">@item.Semester</td>
                </tr>
            }
        </tbody>
    </table>
    <button type="submit">Apply Filters</button>
</form>

<br />

<form method="post">
    <input type="hidden" name="ClassNameFilter" value="@Model.ClassNameFilter" />
    <input type="hidden" name="InstructorFilter" value="@Model.InstructorFilter" />
    <input type="hidden" name="CapacityFilter" value="@Model.CapacityFilter" />
    <input type="hidden" name="SemesterFilter" value="@Model.SemesterFilter" />
    <input type="hidden" name="Page" value="@Model.CurrentPage" />
    <input type="hidden" name="SelectedColumns" id="SelectedColumns" />

    <button type="submit" asp-page-handler="ExportJson">Export JSON</button>
</form>

<br />
<div>
    Page @Model.CurrentPage of @Model.TotalPages<br />
    @if (Model.CurrentPage > 1)
    {
        <a asp-page="Index" asp-route-Page="@(Model.CurrentPage - 1)"
           asp-route-ClassNameFilter="@Model.ClassNameFilter"
           asp-route-InstructorFilter="@Model.InstructorFilter"
           asp-route-CapacityFilter="@Model.CapacityFilter"
           asp-route-SemesterFilter="@Model.SemesterFilter">Previous</a>
    }
    @if (Model.CurrentPage < Model.TotalPages)
    {
        <a asp-page="Index" asp-route-Page="@(Model.CurrentPage + 1)"
           asp-route-ClassNameFilter="@Model.ClassNameFilter"
           asp-route-InstructorFilter="@Model.InstructorFilter"
           asp-route-CapacityFilter="@Model.CapacityFilter"
           asp-route-SemesterFilter="@Model.SemesterFilter">Next</a>
    }
</div>

<style>
    .selected-column {
        background-color: #e0f0ff !important;
    }
    .selected-row {
        background-color: #ffe8cc !important;
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const selected = new Set();
            const filters = [
                { name: 'ClassNameFilter', col: 'ClassName' },
                { name: 'InstructorFilter', col: 'Instructor' },
                { name: 'CapacityFilter', col: 'Capacity' },
                { name: 'SemesterFilter', col: 'Semester' }
            ];

            filters.forEach(f => {
                const val = document.getElementsByName(f.name)[0]?.value;
                if (val && val.trim() !== '') selected.add(f.col);
            });

            document.querySelectorAll('.selectable-column').forEach(th => {
                th.addEventListener('click', () => {
                    const col = th.getAttribute('data-col');
                    if (selected.has(col)) {
                        selected.delete(col);
                        th.classList.remove('selected-column');
                        document.querySelectorAll('.col-' + col).forEach(cell => cell.classList.remove('selected-column'));
                    } else {
                        selected.add(col);
                        th.classList.add('selected-column');
                        document.querySelectorAll('.col-' + col).forEach(cell => cell.classList.add('selected-column'));
                    }
                    updateSelectedColumns();
                });
            });

            document.querySelectorAll('.selectable-row').forEach(tr => {
                tr.addEventListener('click', () => {
                    tr.classList.toggle('selected-row');
                });
            });

            function updateSelectedColumns() {
                document.getElementById('SelectedColumns').value = JSON.stringify([...selected]);
            }

            // Initialize preselected columns based on filters
            document.querySelectorAll('.selectable-column').forEach(th => {
                const col = th.getAttribute('data-col');
                if (selected.has(col)) {
                    th.classList.add('selected-column');
                    document.querySelectorAll('.col-' + col).forEach(cell => cell.classList.add('selected-column'));
                }
            });

            updateSelectedColumns();
        });
    </script>
}
